<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Jellyfin 12.0.x only (net10.0). Support for Jellyfin 10.11.x (net9.0) was
      removed in v2.0.0.0 to drop the maintenance cost of dual-targeting; users
      still on 10.11 can install v1.9.3.0 (the zip without the _jf12 suffix)
      manually - see docs/troubleshooting.md.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.PrivateLibraries</RootNamespace>
    <AssemblyName>Jellyfin.Plugin.PrivateLibraries</AssemblyName>
    <Nullable>enable</Nullable>
    <LangVersion>latestmajor</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <AssemblyVersion>2.1.2.0</AssemblyVersion>
    <FileVersion>2.1.2.0</FileVersion>
    <Version>2.1.2.0</Version>
  </PropertyGroup>

  <!--
    Jellyfin 12.0.x. Pinned to an exact version rather than a floating one on
    purpose: a stray "12.0.0-rcrc3" package exists on nuget.org that sorts
    *above* the real release candidates under SemVer prerelease ordering, so a
    "12.0.*-*" float could silently resolve to it.
  -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <None Remove="Web\private-libraries.js" />
    <EmbeddedResource Include="Configuration\configPage.html" />
    <EmbeddedResource Include="Web\private-libraries.js" />
  </ItemGroup>

</Project>
